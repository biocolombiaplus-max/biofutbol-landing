rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Clientes: cualquiera puede CREAR (formulario público de registro),
    // pero solo un admin autenticado puede leer, editar o borrar.
    match /clientes/{clienteId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Socios/jugadores de cada club: datos sensibles (documento, acudiente,
    // teléfono), solo un admin autenticado puede leer o escribir.
    match /clientes/{clienteId}/socios/{socioId} {
      allow read, write: if request.auth != null;
    }

    // Auditoría: solo admins autenticados pueden leer o escribir.
    match /auditoria/{entryId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // Configuración pública (imágenes de la landing, etc.): cualquiera puede
    // leer (la landing la consulta sin login), solo un admin autenticado
    // puede editarla desde el panel.
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
