rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Súper-administradores de BioFutbol (tú). Un doc por cada UID de admin
    // real, creado a mano desde la consola de Firebase. Sirve para que las
    // reglas distingan "eres el dueño de BioFutbol" de "eres el dueño de un
    // club" — ambos inician sesión con correo/clave, pero tienen permisos
    // distintos.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    function esSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function esDuenoDelClub(clienteId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/clientes/$(clienteId)).data.authUid == request.auth.uid;
    }

    // Un profesor/entrenador es una cuenta de staff creada por el dueño del
    // club (igual que un socio, pero para tomar asistencia y ver sus
    // alumnos). profesoresIndex conecta su UID de Auth con su club, igual
    // que sociosIndex hace para los socios.
    function esProfesorDelClub(clienteId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/profesoresIndex/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profesoresIndex/$(request.auth.uid)).data.clienteId == clienteId;
    }

    // Clientes: cualquiera puede CREAR (formulario público de registro).
    // Leer/editar: el súper-admin de BioFutbol, o el propio club dueño de
    // ese documento (una vez tiene su login real). Borrar: solo súper-admin.
    match /clientes/{clienteId} {
      allow create: if true;
      allow read, update: if esSuperAdmin() ||
        (request.auth != null && resource.data.authUid == request.auth.uid);
      allow delete: if esSuperAdmin();
    }

    // Marca pública del club (nombre, escudo, colores) — sin datos
    // administrativos ni de contacto. Cualquiera puede leerla (la necesita
    // el carnet digital público de cada socio). Solo el súper-admin o el
    // propio club dueño pueden escribirla.
    match /clientes/{clienteId}/publico/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }

    // Autoservicio de acceso (admin/socio-acceso.html): un deportista que ya
    // tiene ficha pero nunca recibió usuario/clave puede crear su propio
    // acceso sin que el club tenga que hacerlo uno por uno. Solo puede tocar
    // SU PROPIA ficha (nunca la de otro), solo mientras siga sin acceso
    // (authUid nulo, primera vez), solo para ponerse a SÍ MISMO como dueño
    // (nunca el uid de otra persona) y solo esos 3 campos — nada más del
    // socio se puede editar por esta vía.
    function puedeAutoreclamarSocio() {
      return request.auth != null &&
        resource.data.get("authUid", null) == null &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["authUid", "correoAcceso", "claveDesactualizada"]);
    }

    // Socios/jugadores de cada club: cualquiera puede CREAR (autorregistro
    // desde el celular) o LEER un socio puntual si tiene su link exacto
    // (portal del deportista, con el ID único como token). Pero listar
    // TODOS los socios de un club (para el panel admin), editar o borrar
    // requiere ser el súper-admin, el propio club dueño, o (solo para
    // reclamar su propio acceso) el mismo deportista — ver arriba.
    match /clientes/{clienteId}/socios/{socioId} {
      allow create: if true;
      allow get: if true;
      // Los profesores también pueden listar y actualizar (necesitan ver a
      // sus alumnos y, al finalizar la asistencia, sumar sus estadísticas de
      // entrenamientosAsistidos/Programados) — pero no borrar.
      allow list, update: if esSuperAdmin() || esDuenoDelClub(clienteId) || esProfesorDelClub(clienteId) || puedeAutoreclamarSocio();
      allow delete: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }

    // Índice liviano documento -> socio, solo para que registro-socio.html
    // (público, sin sesión) pueda revisar con un get() puntual si un
    // deportista ya está registrado, sin poder listar/leer el roster
    // completo del club.
    match /clientes/{clienteId}/documentosSocios/{documento} {
      allow get: if true;
      allow create: if true;
      // Además del club dueño, cualquiera puede actualizar/borrar un índice
      // ya "huérfano" (su socio fue eliminado en algún momento, por ejemplo
      // desde la ficha del socio) — así registro-socio.html se autorepara
      // sola cuando alguien intenta volver a registrarse con ese mismo
      // documento, en vez de quedar bloqueada para siempre con un "ya estás
      // registrado" sin que exista ningún socio real detrás. Nunca permite
      // tocar un índice que sí apunta a un socio real.
      allow update, delete: if esSuperAdmin() || esDuenoDelClub(clienteId) ||
        (resource != null && !exists(/databases/$(database)/documents/clientes/$(clienteId)/socios/$(resource.data.socioId)));
    }

    // Módulos activados por club (equipos, fixture, tabla, etc.) y sus
    // datos: lectura pública (fixture/tabla se muestran sin login a
    // hinchas y familias), escritura solo del súper-admin o el club dueño.
    match /clientes/{clienteId}/modulos/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }
    // Equipos y partidos (fixture): además del dueño, un profesor del club
    // también puede crearlos/editarlos — es lo deportivo del día a día
    // (armar equipos, programar partidos, cargar el resultado y las
    // tarjetas), a diferencia de las inscripciones pagadas de un torneo,
    // que siguen siendo solo del dueño.
    match /clientes/{clienteId}/equipos/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId) || esProfesorDelClub(clienteId);
    }
    match /clientes/{clienteId}/partidos/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId) || esProfesorDelClub(clienteId);
    }
    match /clientes/{clienteId}/llave/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }
    match /clientes/{clienteId}/patrocinadores/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }
    // Gastos del club: información financiera interna, a diferencia de
    // patrocinadores/equipos/etc. no es pública — solo el súper-admin o el
    // propio club dueño pueden leerla y editarla.
    match /clientes/{clienteId}/gastos/{docId} {
      allow read, write: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }
    match /clientes/{clienteId}/sedes/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }
    match /clientes/{clienteId}/horarios/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }
    match /clientes/{clienteId}/excepciones/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }
    match /clientes/{clienteId}/uniformes/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }
    match /clientes/{clienteId}/entrenamientos/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId) || esProfesorDelClub(clienteId);
    }
    match /clientes/{clienteId}/profesores/{docId} {
      allow read: if true;
      // Un profesor puede autorregistrarse desde registro-profesor.html sin
      // necesitar sesión — igual que el autorregistro de socios.
      allow create: if true;
      allow update, delete: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }
    // Torneos: un profesor también puede crear el torneo, ver/editar su
    // información y registrar resultados y tarjetas (eso último ocurre en
    // /partidos). Las inscripciones pagadas del torneo, en cambio, son
    // exclusivas del dueño del club.
    match /clientes/{clienteId}/torneos/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId) || esProfesorDelClub(clienteId);
    }
    match /clientes/{clienteId}/torneos/{torneoId}/inscripciones/{socioId} {
      allow read: if true;
      allow write: if esSuperAdmin() || esDuenoDelClub(clienteId);
    }

    // Índice privado que conecta el UID de Firebase Auth de un socio (o su
    // acudiente) con su club y su documento — igual que /admins/{uid}, pero
    // para socios. Cada uno solo puede leer su propia entrada: con eso le
    // basta a socio-login.html para encontrar su ficha sin exponer las de
    // los demás. Solo el súper-admin o el dueño del club (quien crea el
    // acceso desde socio.html) pueden escribirla.
    match /sociosIndex/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Autoservicio (admin/socio-acceso.html): un deportista puede crear su
      // propia entrada de índice, pero solo DESPUÉS de haber quedado como
      // dueño de esa ficha (ver puedeAutoreclamarSocio arriba) — así que este
      // get() ya confirma que esa ficha es legítimamente suya.
      allow create: if esSuperAdmin() || esDuenoDelClub(request.resource.data.clienteId) ||
        (request.auth != null && request.auth.uid == uid &&
         get(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId)/socios/$(request.resource.data.socioId)).data.authUid == request.auth.uid);
      allow update: if esSuperAdmin() || esDuenoDelClub(request.resource.data.clienteId);
      allow delete: if esSuperAdmin() || (resource != null && esDuenoDelClub(resource.data.clienteId));
    }

    // Mismo índice, pero para profesores/entrenadores.
    match /profesoresIndex/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if esSuperAdmin() || esDuenoDelClub(request.resource.data.clienteId);
      allow delete: if esSuperAdmin() || (resource != null && esDuenoDelClub(resource.data.clienteId));
    }

    // Auditoría: solo admins autenticados (súper-admin o club) pueden leer
    // o escribir, nunca editar/borrar lo ya registrado.
    match /auditoria/{entryId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // Configuración pública (imágenes de la landing, etc.): cualquiera puede
    // leer (la landing la consulta sin login), solo el súper-admin edita.
    match /config/{docId} {
      allow read: if true;
      allow write: if esSuperAdmin();
    }

    // Cotizaciones comerciales enviadas a clubes interesados: uso interno
    // exclusivo del súper-admin (herramienta de ventas, no del club).
    match /cotizaciones/{docId} {
      allow read, write: if esSuperAdmin();
    }

    // Gastos propios de BioFutbol/Biomarketing (publicidad, servidores,
    // herramientas...) para el panel financiero del súper-admin — no tiene
    // nada que ver con las finanzas de ningún club, así que es exclusivo
    // del súper-admin.
    match /finanzasBio/{docId} {
      allow read, write: if esSuperAdmin();
    }
  }
}
