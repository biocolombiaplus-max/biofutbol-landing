rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Contratos: cualquiera puede LEER (para que el cliente abra el link que le mandás
    // por WhatsApp/correo sin necesidad de iniciar sesión), pero solo un admin
    // autenticado puede subir/generar el archivo.
    match /contratos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Logos e imágenes de club: públicos para lectura (se usan en demos/landing
    // de cada cliente), solo un admin autenticado puede subirlos.
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Imágenes de la landing pública (hero, secciones, CTA): públicas para
    // lectura, solo un admin autenticado puede subirlas.
    match /landing/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
